      "id": "measure.define_delay",
      "name": "Define Delay Measurement",
      "category": "measurement",
      "command": ":MEASure:DEFine",
      "set_command": ":MEASure:DEFine DELay,<edge1>,<edge2>[,<source>]",
      "kind": "action",
      "safety": "disruptive",
      "response_type": "raw",
      "description": "Configure the edge polarity and occurrence used by DELAY measurements.",
      "response_notes": "The edge specification accepts an optional slope sign followed by a positive occurrence number, for example 1, +1, -1 or +2.",
      "manual_id": "dsox3000_programmers_guide",
      "manual_page": 438,
      "manual_section": "MEASure Commands",
      "verification_status": "manual_verified",
      "probe_enabled": false,
      "supported_models": [
        "DSO-X 3034A"
      ],
      "notes": "State-changing configuration command. Do not execute in the generic safe probe."
    },
