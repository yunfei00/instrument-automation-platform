{
  "metadata": {
    "manufacturer": "Rohde & Schwarz",
    "family": "FSW",
    "category": "input",
    "status": "mixed"
  },
  "commands": [
    {
      "id": "input.preamp_state",
      "name": "内部前置放大器开关",
      "category": "input",
      "command": "INPut:GAIN:STATe?",
      "set_command": "INPut:GAIN:STATe <state>",
      "query_command": "INPut:GAIN:STATe?",
      "kind": "query",
      "safety": "safe",
      "response_type": "boolean",
      "description": "设置或读取 FSW 内部前置放大器开关状态。",
      "source": "R&S FSW User Manual / official FSW application manuals",
      "verification_status": "hardware_verified",
      "probe_enabled": true,
      "supported_models": ["FSW"],
      "response_notes": "目标 FSW 实机已观察到：开启返回 1，关闭返回 0。",
      "notes": "需要仪表安装内部 Preamplifier 硬件选件；外部前置放大器启用时内部前放可能被自动禁用。"
    },
    {
      "id": "input.preamp_gain",
      "name": "内部前置放大器增益",
      "category": "input",
      "command": "INPut:GAIN[:VALue]?",
      "set_command": "INPut:GAIN[:VALue] <gain>",
      "query_command": "INPut:GAIN[:VALue]?",
      "kind": "query",
      "safety": "safe",
      "response_type": "float",
      "unit": "dB",
      "description": "设置或读取内部前置放大器增益。常用档位为 15 dB 和 30 dB。",
      "source": "R&S FSW User Manual / official FSW application manuals",
      "verification_status": "hardware_verified",
      "probe_enabled": true,
      "supported_models": ["FSW"],
      "response_notes": "目标 FSW 实机已观察到 15 dB 返回 15，30 dB 返回 30。",
      "notes": "关闭状态应以 INPut:GAIN:STATe? 为准；不要仅根据该值判断前置放大器是否开启。"
    },
    {
      "id": "input.rf_attenuation_auto",
      "name": "RF 衰减自动模式",
      "category": "input",
      "command": "INPut:ATTenuation:AUTO?",
      "set_command": "INPut:ATTenuation:AUTO <state>",
      "query_command": "INPut:ATTenuation:AUTO?",
      "kind": "query",
      "safety": "safe",
      "response_type": "boolean",
      "description": "读取或设置 RF 输入衰减是否自动与 Reference Level 联动。0 表示 Manual，1 表示 Auto。",
      "source": "Official R&S FSW manuals: INPut:ATTenuation:AUTO",
      "verification_status": "candidate",
      "probe_enabled": false,
      "supported_models": ["FSW"],
      "notes": "已由官方 FSW 文档确认命令语义，等待目标 FSW 实机确认返回格式后升级为 hardware_verified。"
    },
    {
      "id": "input.rf_attenuation",
      "name": "RF 衰减值",
      "category": "input",
      "command": "INPut:ATTenuation?",
      "set_command": "INPut:ATTenuation <attenuation>",
      "query_command": "INPut:ATTenuation?",
      "kind": "query",
      "safety": "safe",
      "response_type": "float",
      "unit": "dB",
      "description": "读取 RF 输入总衰减；手动设置该值时会解除与 Reference Level 的自动衰减耦合，因此对应前面板 RF Atten Manual。",
      "source": "Official R&S FSW manuals: INPut:ATTenuation",
      "verification_status": "candidate",
      "probe_enabled": false,
      "supported_models": ["FSW"],
      "notes": "机械衰减通常以 5 dB 为步进；安装电子衰减器时总衰减可具有更细步进，实际范围由型号/选件决定。"
    },
    {
      "id": "input.rf_attenuation_auto_mode",
      "name": "RF 自动衰减优化模式",
      "category": "input",
      "command": "INPut:ATTenuation:AUTO:MODE?",
      "set_command": "INPut:ATTenuation:AUTO:MODE <mode>",
      "query_command": "INPut:ATTenuation:AUTO:MODE?",
      "kind": "query",
      "safety": "safe",
      "response_type": "string",
      "description": "设置或读取自动 RF 衰减的优化策略。LNOise 偏向高灵敏度/低噪声，LDIStortion 偏向低失真。",
      "source": "Official R&S FSW manuals: INPut:ATTenuation:AUTO:MODE",
      "verification_status": "candidate",
      "probe_enabled": false,
      "supported_models": ["FSW"],
      "notes": "常用设置为 LNOise 或 LDIStortion。"
    },
    {
      "id": "input.electronic_attenuator_state",
      "name": "电子衰减器开关",
      "category": "input",
      "command": "INPut:EATT:STATe?",
      "set_command": "INPut:EATT:STATe <state>",
      "query_command": "INPut:EATT:STATe?",
      "kind": "query",
      "safety": "safe",
      "response_type": "boolean",
      "description": "设置或读取可选电子衰减器是否进入 RF 信号通路。",
      "source": "Official R&S FSW manuals: INPut:EATT:STATe",
      "verification_status": "candidate",
      "probe_enabled": false,
      "supported_models": ["FSW"],
      "notes": "仅在安装对应 Electronic Attenuator 硬件选件时可用。"
    },
    {
      "id": "input.electronic_attenuation_auto",
      "name": "电子衰减自动模式",
      "category": "input",
      "command": "INPut:EATT:AUTO?",
      "set_command": "INPut:EATT:AUTO <state>",
      "query_command": "INPut:EATT:AUTO?",
      "kind": "query",
      "safety": "safe",
      "response_type": "boolean",
      "description": "设置或读取电子衰减是否自动选择。",
      "source": "Official R&S FSW manuals: INPut:EATT:AUTO",
      "verification_status": "candidate",
      "probe_enabled": false,
      "supported_models": ["FSW"],
      "notes": "仅在安装对应 Electronic Attenuator 硬件选件时可用。"
    },
    {
      "id": "input.electronic_attenuation",
      "name": "电子衰减值",
      "category": "input",
      "command": "INPut:EATT?",
      "set_command": "INPut:EATT <attenuation>",
      "query_command": "INPut:EATT?",
      "kind": "query",
      "safety": "safe",
      "response_type": "float",
      "unit": "dB",
      "description": "设置或读取电子衰减值；手动设置前应关闭 INPut:EATT:AUTO。",
      "source": "Official R&S FSW manuals: INPut:EATT",
      "verification_status": "candidate",
      "probe_enabled": false,
      "supported_models": ["FSW"],
      "notes": "仅在安装对应 Electronic Attenuator 硬件选件时可用，典型步进为 1 dB。"
    }
  ]
}
