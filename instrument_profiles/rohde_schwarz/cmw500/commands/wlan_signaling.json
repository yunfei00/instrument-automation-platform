      "probe_enabled": false,
      "supported_models": ["CMW*"],
      "parameters": [{"name": "power", "position": 1, "required": true, "type": "float", "unit": "dBm", "examples": [-80, -40, -20, 0], "description": "WLAN TX Burst Power。实际范围取决于 RF 路径、频段及外部衰减。"}],
      "example_commands": ["CONFigure:WLAN:SIGN:RFSettings:BOPower -40"],
