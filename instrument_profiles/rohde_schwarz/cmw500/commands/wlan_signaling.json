  "commands": [
    {
      "id": "wlan_signaling.route_scell_flexible",
      "name": "WLAN Signaling Flexible Standard Cell 路由",
      "category": "wlan_signaling",
      "command": "ROUTe:WLAN:SIGN:SCENario:SCELl:FLEXible?",
      "set_command": "ROUTe:WLAN:SIGN:SCENario:SCELl:FLEXible <suu>,<rx_connector>,<rx_converter>,<tx_connector>,<tx_converter>",
      "query_command": "ROUTe:WLAN:SIGN:SCENario:SCELl:FLEXible?",
      "kind": "query",
      "safety": "safe",
      "response_type": "csv",
      "description": "设置或查询 WLAN Signaling Standard Cell Flexible RF 路由。",
      "verification_status": "manual_verified",
      "probe_enabled": false,
      "supported_models": ["CMW*"],
      "parameters": [
        {"name": "suu", "position": 1, "required": true, "type": "enum", "known_values": ["SUU1"], "description": "Signaling Unit/User Unit 标识；当前已知配置使用 SUU1。"},
        {"name": "rx_connector", "position": 2, "required": true, "type": "enum", "known_values": ["RF1C", "RF2C", "RF3C", "RF4C"], "description": "WLAN 接收路径 RF Connector。"},
        {"name": "rx_converter", "position": 3, "required": true, "type": "enum", "known_values": ["RX1", "RX2"], "description": "接收转换器。RF1/RF2 常配 RX1，RF3/RF4 常配 RX2。"},
        {"name": "tx_connector", "position": 4, "required": true, "type": "enum", "known_values": ["RF1C", "RF2C", "RF3C", "RF4C"], "description": "WLAN 发射路径 RF Connector。"},
        {"name": "tx_converter", "position": 5, "required": true, "type": "enum", "known_values": ["TX1", "TX2"], "description": "发射转换器。RF1/RF2 常配 TX1，RF3/RF4 常配 TX2。"}
      ],
      "known_port_mappings": {
        "COM1": ["SUU1", "RF1C", "RX1", "RF1C", "TX1"],
        "COM2": ["SUU1", "RF2C", "RX1", "RF2C", "TX1"],
        "COM3": ["SUU1", "RF3C", "RX2", "RF3C", "TX2"],
        "COM4": ["SUU1", "RF4C", "RX2", "RF4C", "TX2"]
      },
      "example_commands": [
        "ROUTe:WLAN:SIGN:SCENario:SCELl:FLEXible SUU1,RF1C,RX1,RF1C,TX1",
        "ROUTe:WLAN:SIGN:SCENario:SCELl:FLEXible SUU1,RF4C,RX2,RF4C,TX2"
      ],
      "notes": "R&S WLAN signaling application notes show the same Flexible Standard Cell routing structure, e.g. SUA1/SUU1 + RF connector + RX/TX converter. Exact unit token can depend on firmware/application naming; current target workflow uses SUU1."
    },
    {
