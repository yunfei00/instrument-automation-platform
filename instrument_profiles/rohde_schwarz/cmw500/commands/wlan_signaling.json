      "probe_enabled": false,
      "supported_models": ["CMW*"],
      "parameters": [{"name": "attenuation", "position": 1, "required": true, "type": "float", "unit": "dB", "examples": [0, 20, 35], "description": "输入链路外部衰减。实际可用范围依固件与 RF 前端配置。"}],
      "example_commands": ["CONFigure:WLAN:SIGN:RFSettings:EATTenuation:INPut 35"],
      "notes": "你原始文本中的 'E ATTenuation' 按 SCPI 正规形式记录为 EATTenuation。"
    },
