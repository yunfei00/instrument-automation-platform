      "probe_enabled": false,
      "supported_models": ["CMW*"],
      "parameters": [{"name": "standard", "position": 1, "required": true, "type": "enum", "known_values": ["ASTD", "BSTD", "GSTD", "GOST", "NGFStd", "ANSTD", "GNSTd", "GONStd"], "value_meanings": {"ASTD": "802.11a", "BSTD": "802.11b", "GSTD": "802.11g", "GOST": "802.11g OFDM", "NGFStd": "802.11n", "ANSTD": "802.11a/n", "GNSTd": "802.11g/n", "GONStd": "802.11g OFDM/n"}, "description": "WLAN standard token；已按当前 CMW500 实际调试枚举记录。"}],
      "example_commands": ["CONFigure:WLAN:SIGN:CONNection:STANdard ASTD", "CONFigure:WLAN:SIGN:CONNection:STANdard NGFStd"],
      "notes": "这些 token 来自当前目标仪表/工作流，后续真机逐一查询验证后可升级为 hardware_verified。"
    },
